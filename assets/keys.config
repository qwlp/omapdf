# Omapdf command key syntax. Override in keys_user.config.
goto_beginning gg
goto_end G
goto_end <end>
goto_page_with_page_number <home>
next_page <C-<pagedown>>
previous_page <C-<pageup>>
move_down j
move_up k
move_down <down>
move_up <up>
move_left <left>
move_right <right>
screen_down <space>
screen_up <S-<space>>
screen_down <pagedown>
screen_up <pageup>
zoom_in +
zoom_in =
zoom_out -
fit_to_page_width w
fit_to_page f
goto_toc t
open_document <C-o>
open_path o
open_prev_doc O
search /
search <C-f>
next_item n
previous_item N
command :
execute_command <C-p>
prev_state <backspace>
set_mark m
goto_mark `
goto_mark '
add_bookmark b
goto_bookmark gb
goto_bookmark_g gB
goto_bookmark B
add_highlight h
goto_highlight gh
goto_highlight H
delete_highlight dh
delete_bookmark db
delete_portal dp
copy <C-c>
portal p
goto_portal gp
goto_portal <tab>
toggle_window_configuration <f12>
overview_to_portal v
prev_state <A-<left>>
next_state <A-<right>>
toggle_dark_mode <f8>
toggle_fullscreen <f11>
fit_to_page <f9>
fit_to_page_width <f10>
reload <C-r>
help ?
quit <C-q>

settings <C-,>

cycle_layout L

context_menu <menu>
context_menu <S-<f10>>

# Move the wheel line by line while the visual ruler is active.
toggle_visual_scroll <f7>

next_tab gt
previous_tab gT
close_tab gq
